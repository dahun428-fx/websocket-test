NODE_ENV=development
LOG_LEVEL=info
HOST=0.0.0.0
PORT=3010
DATABASE_PATH=data/chat.db

JWT_ACCESS_SECRET=local-development-access-secret-change-before-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=local-development-refresh-secret-change-before-production
JWT_REFRESH_EXPIRES_IN=7d

REFRESH_TOKEN_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_MAX_AGE_SECONDS=604800
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_FAIL_MODE=open
TRUST_PROXY=false

HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_DEBUG=false

OUTBOX_WORKER_ENABLED=true
OUTBOX_POLLING_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAXIMUM_ATTEMPTS=5
OUTBOX_STALE_PROCESSING_MS=30000
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAXIMUM_DELAY_MS=60000

REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=chat-app:development
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000
REDIS_RECONNECT_BASE_DELAY_MS=100
REDIS_RECONNECT_MAXIMUM_DELAY_MS=3000
REDIS_RECONNECT_MAXIMUM_RETRIES=20
REDIS_PRESENCE_TTL_SECONDS=30
REDIS_PRESENCE_HEARTBEAT_INTERVAL_MS=10000
# INSTANCE_ID=chat-server-local

SEED_USER_PASSWORD=replace-with-a-local-demo-password
